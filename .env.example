# domainfinder configuration. Copy to .env and fill in what you need.
# Every setting is optional.

# --- Key-based providers (each turns on when its key is set) ---
# WhoisXML is implemented (free account: 500 credits); SecurityTrails and
# DomainTools are stubs today.
SECURITYTRAILS_API_KEY=
WHOISXML_API_KEY=
# WhoisXML reverse WHOIS: current, historic or both (default); pages of 10,000
# domains a search may buy (1 credit each).
DOMAINFINDER_WHOISXML_SEARCH=both
DOMAINFINDER_WHOISXML_MAX_PAGES=1
DOMAINTOOLS_API_USERNAME=
DOMAINTOOLS_API_KEY=

# --- Free providers that need a (free) key ---
VIEWDNS_API_KEY=

# SEC EDGAR asks every client to identify itself with a name and contact
# address, e.g. "Example Corp security-team@example.com". The EDGAR source
# stays off until this is set.
DOMAINFINDER_SEC_USER_AGENT=

# Optional contact details added to the User-Agent for Wikidata queries, e.g.
# "Example Corp security-team@example.com". Wikimedia asks automated clients
# for contact details and may refuse (HTTP 403) those without. Sent to
# Wikidata only; leave empty to send no contact details.
DOMAINFINDER_CONTACT=

# --- Behaviour ---
# DNS mode: auto (system resolver, DNS-over-HTTPS if it does not answer),
# system, or doh.
DOMAINFINDER_DNS_MODE=auto
# Internationalized domains in output: unicode (example.信息, default) or
# punycode (example.xn--vuq861b). CSV/JSON always include both columns.
DOMAINFINDER_IDN=unicode
# Cache: domainfinder-cache.sqlite in the directory you run from (or here).
DOMAINFINDER_CACHE_DIR=
# Freshness for websites (other sources have their own, see README).
DOMAINFINDER_CACHE_TTL_HOURS=24
# Expired answers are kept this long, for use when a fresh lookup fails.
DOMAINFINDER_CACHE_MAX_STALE_DAYS=30
DOMAINFINDER_CONCURRENCY=12
DOMAINFINDER_HIGH_THRESHOLD=70
DOMAINFINDER_REVIEW_THRESHOLD=40
# crt.sh: query its public database first (port 5432), its web API if that fails.
# 0 = web API only. The limit is rows per database search (the web API stops at 10,000).
DOMAINFINDER_CRTSH_DB=1
DOMAINFINDER_CRTSH_DB_LIMIT=50000
# Seconds per database search (a large organization's full history needs minutes).
DOMAINFINDER_CRTSH_DB_TIMEOUT=300
# Wikidata subsidiaries (1) / CT search for acquired companies' names (1). 0 turns off.
DOMAINFINDER_WIKIDATA=1
DOMAINFINDER_ACQUISITIONS=1
# Second pass over domains named in the CSP of owned/review domains. 0 turns it off.
DOMAINFINDER_CSP=1
# Free HackerTarget reverse-NS lookups (small daily quota). 0 turns them off.
DOMAINFINDER_HACKERTARGET=1
# With a paid reverse-NS source, an NS set used by more domains than this is
# treated as shared hosting.
DOMAINFINDER_SHARED_NS_THRESHOLD=5000
