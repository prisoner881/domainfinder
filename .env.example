# domainfinder configuration. Copy to .env and fill in what you need.
# Every setting is optional.

# --- Paid providers (stubs today; a provider turns on when its key is set) ---
SECURITYTRAILS_API_KEY=
WHOISXML_API_KEY=
DOMAINTOOLS_API_USERNAME=
DOMAINTOOLS_API_KEY=

# --- Free providers that need a (free) key ---
VIEWDNS_API_KEY=

# SEC EDGAR asks every client to identify itself with a name and contact
# address, e.g. "Example Corp security-team@example.com". The EDGAR source
# stays off until this is set.
DOMAINFINDER_SEC_USER_AGENT=

# --- Behaviour ---
# DNS mode: auto (system resolver, DNS-over-HTTPS if it does not answer),
# system, or doh.
DOMAINFINDER_DNS_MODE=auto
# Internationalized domains in output: unicode (adp.信息, default) or
# punycode (adp.xn--vuq861b). CSV/JSON always include both columns.
DOMAINFINDER_IDN=unicode
DOMAINFINDER_CACHE_DIR=
DOMAINFINDER_CACHE_TTL_HOURS=24
DOMAINFINDER_CONCURRENCY=12
DOMAINFINDER_HIGH_THRESHOLD=70
DOMAINFINDER_REVIEW_THRESHOLD=40
# Free HackerTarget reverse-NS lookups (small daily quota). 0 turns them off.
DOMAINFINDER_HACKERTARGET=1
# With a paid reverse-NS source, an NS set used by more domains than this is
# treated as shared hosting.
DOMAINFINDER_SHARED_NS_THRESHOLD=5000
